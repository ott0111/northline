# Northline server configuration
# Copy this file to .env.local for local development.
# Never commit real credentials or API keys.

NODE_ENV=development

# Neon / PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional email notifications for new submissions
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=you@example.com
FROM_EMAIL=Northline <you@example.com>

# GitHub Pages frontend -> Vercel API origin
NORTHLINE_API_ORIGIN=https://northline-web-three.vercel.app
