# Northline server configuration
# Copy this file to .env.local for local development.
# Never commit real credentials or API keys.

NODE_ENV=development

# Admin login + session signing
# ADMIN_PASSWORD is the password you type into /admin.
# ADMIN_SECRET signs the admin session cookie. Use a long random value.
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=change-this-to-a-long-random-secret

# Neon / PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional email notifications for new submissions
RESEND_API_KEY=
ADMIN_EMAIL=you@example.com
FROM_EMAIL=Northline <noreply@yourdomain.com>

# GitHub Pages frontend -> Vercel API origin
NORTHLINE_API_ORIGIN=https://northline-web-three.vercel.app
